# Public browser settings (the anon key is intentionally public and protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public Turnstile site key (never put the Turnstile secret key in a VITE_ variable)
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-only Vercel settings; never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
GEMINI_API_KEY=OPTIONAL_SERVER_ONLY_KEY

# Enable only after Google provider and exact redirect URLs are configured
VITE_GOOGLE_AUTH_ENABLED=false

# Preparation only: public VAPID key may be returned by /api/push after login.
# Keep registration off until the SQL gate is reviewed in an isolated project.
PUSH_REGISTRATION_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
# Private VAPID key belongs ONLY in Supabase Edge Function secrets.
# Do not add a VITE_ private key.

# Stage 6G-B: the sender is a separate, default-disabled Supabase Edge Function.
# DO NOT put private keys/operator tokens/service-role keys in Vercel Preview.
# Supabase Edge Function secrets (separate isolated project / Production):
# PUSH_TEST_DELIVERY_ENABLED=false
# PUSH_TEST_OPERATOR_TOKEN=<independent random 32-byte base64url operator secret>
# PUSH_VAPID_PUBLIC_KEY=<same public key as the reviewed DB gate and Vercel>
# PUSH_VAPID_PRIVATE_KEY=<private VAPID scalar; never VITE_ or browser/SW>
# PUSH_VAPID_SUBJECT=mailto:<monitored-contact>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are platform-injected in Edge only.
# DB push_controls.test_delivery_enabled stays false; no permits created by migration.
