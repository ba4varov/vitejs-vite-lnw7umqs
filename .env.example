# Public browser settings (the anon key is intentionally public and protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public Turnstile site key (never put the Turnstile secret key in a VITE_ variable)
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-only Vercel settings; never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
GEMINI_API_KEY=OPTIONAL_SERVER_ONLY_KEY

# Enable only after Google provider and exact redirect URLs are configured
VITE_GOOGLE_AUTH_ENABLED=false

# Preparation only: public VAPID key may be returned by /api/push after login.
# Keep registration off until the SQL gate is reviewed in an isolated project.
PUSH_REGISTRATION_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
# Future private VAPID key belongs ONLY in Supabase Edge Function secrets.
# No sender is implemented in stage 6G-A; do not add a VITE_ private key.
