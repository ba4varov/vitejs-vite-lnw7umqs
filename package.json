{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.mjs src/*.test.mjs",
    "test:charts:browser": "playwright test --config=playwright.charts.config.ts",
    "test:forecast:browser": "playwright test --config=playwright.forecast-cards.config.ts",
    "test:admin:browser": "playwright test",
    "test:admin:sql": "node scripts/test-admin-sql.mjs",
    "test:service-role:sql": "node scripts/test-service-role-privileges.mjs",
    "typecheck": "tsc -b",
    "test:signup:browser": "playwright test --config=playwright.signup.config.ts",
    "test:signup:sql": "node scripts/test-signup-activity-sql.mjs",
    "test:activity:integration": "node scripts/test-activity-integration.mjs",
    "test:profile:build": "playwright test --config=playwright.profile-build.config.ts",
    "test:push:edge": "node scripts/test-push-edge.mjs"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.117.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "3.6.7",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
